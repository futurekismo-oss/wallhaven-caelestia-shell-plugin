#!/usr/bin/env python3
import json, os, sys, hashlib, urllib.request, urllib.parse, subprocess, random as rnd, time, signal
from pathlib import Path

HOME = Path.home()
CONFIG_DIR = HOME / ".config" / "caelestia"
CACHE_DIR = HOME / ".cache" / "caelestia"
CONFIG_FILE = CONFIG_DIR / "wallhaven.jsonc"
INDEX_FILE = CACHE_DIR / "wallhaven-index.json"
API_BASE = "https://wallhaven.cc/api/v1"
UA = "Caelestia-Wallhaven/1.0"

# Uses a Notify Id so the notification history
# doesnt clutter by replacing the notifcation rather than
# making a new one
NOTIFY_ID = 9901


def notify(summary, body, urgency="normal"):
    # notification function
    subprocess.run(
        [
            "notify-send",
            "-a",
            "Wallhaven",
            "-u",
            urgency,
            "-r",
            str(NOTIFY_ID),
            summary,
            body,
        ],
        capture_output=True,
    )


def parse_jsonc(text):
    # Strips comments from the Json file
    lines = []
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("//"):
            continue
        if "//" in line:
            idx = line.find("//")
            # If numbers of comments before // is an even number
            # The comment is outside a string
            if line[:idx].count('"') % 2 == 0:
                lines.append(line[:idx])
                continue
        lines.append(line)
    return json.loads("\n".join(lines))


def load_config():
    if not CONFIG_FILE.exists():
        CONFIG_FILE.parent.mkdir(parents=True, exist_ok=True)
        write_default_config()
        print(f"Created default config at {CONFIG_FILE}\nEdit it and run again.")
        sys.exit(0)
    return parse_jsonc(CONFIG_FILE.read_text())


