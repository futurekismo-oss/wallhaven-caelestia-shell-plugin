def load_index():
    # Loads the index that prevents duplication ( installing the same wallpaper
    # twice )
    if INDEX_FILE.exists():
        try:
            return json.loads(INDEX_FILE.read_text())
        except json.JSONDecodeError:
            return {}
    return {}


def save_index(idx):
    # Saves the index of a wallpaper to the index file
    INDEX_FILE.parent.mkdir(parents=True, exist_ok=True)
    INDEX_FILE.write_text(json.dumps(idx, indent=2) + "\n")


def get_wallpaper_dir():
    # Gets the wallpaperDir from caelestia/shell.json
    cfg = CONFIG_DIR / "shell.json"
    if cfg.exists():
        try:
            d = json.loads(cfg.read_text()).get("paths", {}).get("wallpaperDir", "")
            if d:
                return Path(d)
        except (json.JSONDecodeError, KeyError):
            pass
    # If function fails set the wallpaperDir to home/Pictures/Wallpapers
    return HOME / "Pictures" / "Wallpapers"


def api_get(url, api_key="", retries=3):
    # Gets the url and the optional API Key
    if api_key:
        # if api key is given add it to the url with either ? or & depending on
        # if previouse parameters exists ( Wallhaven-url behaviour )
        sep = "&" if "?" in url else "?"
        url = f"{url}{sep}apikey={api_key}"
    req = urllib.request.Request(
        url, headers={"User-Agent": UA}
    )  # Makes a url request. Adds a User-Agent for security

    for i in range(retries):
        try:
            # Tries a GET-request with a 15 second timeout and converts the json
            # repsonse to a python dict
            with urllib.request.urlopen(req, timeout=15) as resp:
                return json.loads(resp.read())
        except urllib.error.HTTPError as e:  # Catches HTTP Errors
            msg = f"API error: {e.code} {e.reason}"
            if e.code == 429:  # Special case for rate limits errors
                print("Rate limited. API key helps.", file=sys.stderr)
            elif e.code >= 500 and i < retries - 1:
                time.sleep(2**i)
                continue
            raise RuntimeError(msg)
        except urllib.error.URLError as e:  # Catches Network Errors
            msg = f"Network error: {e.reason}"
            print(msg, file=sys.stderr)
            raise RuntimeError(msg)


def download_file(url, dest):  # Downloads a image and stores it in a given dir
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            with open(dest, "wb") as f:
                f.write(resp.read())
    except Exception as e:
        if dest.exists():
            dest.unlink(missing_ok=True)
        raise e


def is_duplicate(dest, wallpaper_dir):
    # Catches Wallpaper duplication
    # ( Hashing method )
    if not dest.exists():
        return False

    new_size = dest.stat().st_size
    new_hash = None  # Lazy load hash only if file sizes match

    for ext in ("*.jpg", "*.jpeg", "*.png", "*.webp"):
        for f in wallpaper_dir.rglob(ext):
            if f.resolve() == dest.resolve():
                continue
            # If sizes don't match, the content CANNOT be identical
            if f.stat().st_size == new_size:
                if new_hash is None:
                    new_hash = hashlib.sha256(dest.read_bytes()).hexdigest()
                if hashlib.sha256(f.read_bytes()).hexdigest() == new_hash:
                    return True
    return False


def set_wallpaper(path, config=None):
    # Sets the wallpaper using the caelestia wallpaper cmd  ( caelestia
    # wallpaper -f )
    if config and config.get("use_dynamic_scheme"):
        # Tries to set a dynamic scheme
        subprocess.run(["caelestia", "scheme", "set", "dynamic"], capture_output=True)
    caelestia = subprocess.run(
        ["caelestia", "wallpaper", "-f", str(path)], capture_output=True, text=True
    )
    if caelestia.returncode != 0:
        print(f"Failed to set wallpaper: {caelestia.stderr.strip()}", file=sys.stderr)
        return False
    return True


def prune_cache(idx, config):
    max_keep = config.get("max_keep_wallpapers", 30)
    enable = config.get("auto_delete_wallpapers", False)
    if max_keep <= 0 or len(idx) <= max_keep or enable:
        return idx

    all_keys = list(idx.keys())
    overflow_count = len(idx) - max_keep
    keys_to_remove = all_keys[:overflow_count]

    print(f"Cache limit exceeded. Pruning {overflow_count} old wallpaper(s)...")
    for wid in keys_to_remove:
        path_str = idx[wid].get("path")
        if path_str:
            p = Path(path_str)
            if p.exists():
                p.unlink(missing_ok=True)
                print(f"Auto-deleted old wallpaper: {p.name}")
        del idx[wid]

    save_index(idx)
    return idx


def cmd_random(config):
    idx = load_index()
    wall_dir = get_wallpaper_dir()
    wall_dir.mkdir(parents=True, exist_ok=True)
    existing_ids = set(idx.keys())
    notify("Wallhaven", "Fetching random wallpaper...")

    sorting = config.get("sorting", "random")

    params = {
        "categories": config.get("categories", "111"),
        "purity": config.get("purity", "100"),
        "sorting": sorting,
        "order": config.get("order", "desc"),
    }
    if config.get("query"):
        params["q"] = config["query"]
    if config.get("atleast"):
        params["atleast"] = config["atleast"]
    if config.get("resolutions"):
        params["resolutions"] = ",".join(config["resolutions"])
    if config.get("ratios"):
        params["ratios"] = config["ratios"]

    if sorting == "toplist" and "topRange" not in params:
        params["topRange"] = "1m"

    ak = config.get("api_key", "")
    query_string = urllib.parse.urlencode(params)
    data = api_get(f"{API_BASE}/search?{query_string}", ak)

    if sorting == "random":
        last = 1
    else:
        last = data.get("meta", {}).get("last_page", 1)

    attempted = set()
    for _ in range(15):
        page = rnd.randint(1, last)
        if page in attempted:
            continue
        attempted.add(page)

        page_params = {**params, "page": page}
        if sorting == "random":
            page_params["seed"] = str(rnd.randint(100000, 999999))

        data = api_get(f"{API_BASE}/search?" + urllib.parse.urlencode(page_params), ak)
        wallpapers = data.get("data", [])

        if not wallpapers:
            continue

        rnd.shuffle(wallpapers)
        for wp in wallpapers:
            wid = wp["id"]
            if wid in existing_ids:
                continue

            img_url = wp["path"]
            ext = os.path.splitext(img_url)[1] or ".jpg"
            dest = wall_dir / f"wallhaven-{wid}{ext}"
            print(f"Downloading: {wp['resolution']} {wp['url']}")
            try:
                download_file(img_url, dest)
            except Exception as e:
                print(f"Download failed: {e}", file=sys.stderr)
                continue

            if is_duplicate(dest, wall_dir):
                print("Duplicate (same content), skipping")
                dest.unlink(missing_ok=True)
                existing_ids.add(wid)
                continue

            idx[wid] = {
                "path": str(dest),
                "url": wp["url"],
                "resolution": wp.get("resolution", ""),
            }
            idx = prune_cache(idx, config)
            save_index(idx)
            print(f"Saved: {dest.name}")
            set_wallpaper(dest, config)
            notify("Wallhaven", f"Set: {dest.name}", "low")
            return

    notify("Wallhaven", "No new wallpapers found. Try different filters.")


def get_cached_thumbnail(url):
    THUMB_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    url_hash = hashlib.md5(url.encode("utf-8")).hexdigest()
    ext = os.path.splitext(url)[1] or ".jpg"
    dest = THUMB_CACHE_DIR / f"{url_hash}{ext}"
    if not dest.exists() or dest.stat().st_size == 0:
        try:
            download_file(url, dest)
        except Exception as e:
            print(f"Error downloading {url}: {e}", file=sys.stderr)
            return None
    return dest


def cmd_preview(url):
    sys.stdout.write("\033_Ga=d,d=A\033\\")
    sys.stdout.flush()

    local_path = get_cached_thumbnail(url.strip())
    if not local_path or not local_path.exists():
        print("Failed to load thumbnail.")
        return

    cols = os.environ.get("FZF_PREVIEW_COLUMNS", "80")
    lines = os.environ.get("FZF_PREVIEW_LINES", "40")

    if shutil.which("chafa"):
        subprocess.run(["chafa", f"--size={cols}x{lines}", str(local_path)])
        return

    if shutil.which("kitten"):
        subprocess.run(
            [
                "kitten",
                "icat",
                "--clear",
                "--transfer-mode=memory",
                "--stdin=no",
                f"--place={cols}x{lines}@0x0",
                str(local_path),
            ]
        )
        return
    elif shutil.which("kitty"):
        subprocess.run(
            [
                "kitty",
                "+kitten",
                "icat",
                "--clear",
                "--transfer-mode=memory",
                "--stdin=no",
                f"--place={cols}x{lines}@0x0",
                str(local_path),
            ]
        )
        return

    print(f"Thumbnail cached: {local_path}\n\nInstall 'chafa' for in-terminal preview.")


def get_latest_release_tag(repo_owner, repo_name):
    # Try releases endpoint first
    url = f"https://api.github.com/repos/{repo_owner}/{repo_name}/releases/latest"
    req = urllib.request.Request(url, headers={"User-Agent": "Wallhaven-Fetch"})

    try:
        with urllib.request.urlopen(req) as response:
            data = json.loads(response.read().decode())
            return data.get("tag_name", "v0.0").lstrip("v")
    except Exception:
        # Fallback: Try tags endpoint
        tags_url = f"https://api.github.com/repos/{repo_owner}/{repo_name}/tags"
        req = urllib.request.Request(
            tags_url, headers={"User-Agent": "Wallhaven-Fetch"}
        )
        try:
            with urllib.request.urlopen(req) as response:
                tags = json.loads(response.read().decode())
                if tags:
                    # The tags API returns them in descending order of creation
                    return tags[0].get("name", "0.0").lstrip("v")
        except Exception:
            return None
    return None


def check_for_updates():
    now = time.time()

    if CACHE_FILE.exists():
        try:
            with open(CACHE_FILE, "r") as f:
                cache = json.load(f)
                # Every hour
                if now - cache.get("last_check", 0) < 3600:
                    return
        except (json.JSONDecodeError, ValueError):
            pass

    remote_version = get_latest_release_tag("futurekismo-oss", REPO_NAME)
    if remote_version is None:
        return

    CACHE_FILE.parent.mkdir(parents=True, exist_ok=True)
    with open(CACHE_FILE, "w") as f:
        json.dump({"last_check": now}, f)

    def v_tuple(v):
        return tuple(map(int, v.split(".")))

    if v_tuple(remote_version) > v_tuple(CURRENT_VERSION):
        notify(
            "Update Available",
            f"{CURRENT_VERSION} -> {remote_version} \n Run wallhaven-fetch update to update",
        )


def cmd_update():
    print("Fetching and running the installation script...")

    current_script_path = os.path.abspath(__file__)
    install_dir = os.path.dirname(current_script_path)

    if "wallhaven-caelestia-shell-plugin" in install_dir:
        env_override = ""
    else:
        env_override = f"export INSTALL_DIR='{install_dir}'; "

    update_cmd = f"{env_override}curl -sSL -H 'Cache-Control: no-cache' https://raw.githubusercontent.com/futurekismo-oss/wallhaven-caelestia-shell-plugin/refs/heads/main/update.sh | bash"

    result = subprocess.run(
        update_cmd,
        shell=True,
    )

    if result.returncode == 0:
        remote_version = get_latest_release_tag("futurekismo-oss", REPO_NAME)
        print(f"\nUpdate applied successfully! Remote version: {remote_version}")
        print("Please restart or re-run the script to use the updated version.\n")
        sys.exit(0)
    else:
        print(
            "Updater failed.",
            file=sys.stderr,
        )
        sys.exit(1)


def cmd_search(config, query, page_togo=1):
    if shutil.which("fzf") is None:
        print("Error: fzf is not installed. Please install it.", file=sys.stderr)
        sys.exit(1)

    if page_togo > 0:
        page = page_togo
    else:
        page = 1
    script_path = os.path.abspath(__file__)

    while True:
        params = {
            "q": query,
            "categories": config.get("categories", "111"),
            "purity": config.get("purity", "100"),
            "page": page,
        }
        data = api_get(
            f"{API_BASE}/search?" + urllib.parse.urlencode(params),
            config.get("api_key", ""),
        )
        wallpapers = data.get("data", [])

        if not wallpapers and page == 1:
            print("No wallpapers found.")
            return
        elif not wallpapers and page > 1:
            print("No more wallpapers found. Going back a page.")
            page -= 1
            continue

        choices = []
        for wp in wallpapers:
            wid = wp["id"]
            res = wp["resolution"]
            thumb = wp.get("thumbs", {}).get(
                "large", wp.get("thumbs", {}).get("small", "")
            )
            choices.append(f"{wid}|{res}|{thumb}")

        if page > 1:
            choices.append(f"[Go to Page {page - 1}], Prev")
        choices.append(f"[Go to Page {page + 1}], Next")

        process = subprocess.run(
            [
                "fzf",
                "--height",
                "80%",
                "--reverse",
                "--cycle",
                "--delimiter",
                r"\|",
                "--style",
                "full",
                "--with-nth",
                "1,2",
                "--preview",
                f'"{sys.executable}" "{script_path}" preview \'{{3}}\'',
                "--preview-window",
                "right:50%",
            ],
            input="\n".join(choices),
            stdout=subprocess.PIPE,
            text=True,
        )

        sys.stdout.write("\033_Ga=d,d=A\033\\")
        sys.stdout.flush()

        if process.returncode != 0 or not process.stdout:
            break

        selected = process.stdout.strip()

        if selected.startswith("[Go to Page"):
            selected = selected.split(",")[0]
            target_page = int(selected.replace("[Go to Page ", "").replace("]", ""))
            page = target_page
        else:
            selected_id = selected.split("|")[0]
            cmd_download(config, selected_id)
            break


def cmd_download(config, wid):
    idx = load_index()
    if wid in idx:
        p = Path(idx[wid]["path"])
        if p.exists():
            print(f"Already downloaded: {p}")
            set_wallpaper(p, config)
            notify("Wallhaven", f"Set (cached): {p.name}", "low")
            return

    notify("Wallhaven", f"Downloading {wid}...")
    wall_dir = get_wallpaper_dir()
    wall_dir.mkdir(parents=True, exist_ok=True)

    data = api_get(f"{API_BASE}/w/{wid}", config.get("api_key", ""))
    wp = data.get("data", {})
    img_url = wp.get("path")
    if not img_url:
        print(f"Wallpaper {wid} not found", file=sys.stderr)
        return

    ext = os.path.splitext(img_url)[1] or ".jpg"
    dest = wall_dir / f"wallhaven-{wid}{ext}"
    print(f"Downloading: {wp.get('resolution', '?')} {wp.get('url', '?')}")

    try:
        download_file(img_url, dest)
    except Exception as e:
        print(f"Download failed: {e}", file=sys.stderr)
        notify("Wallhaven", f"Download failed for {wid}", "critical")
        return

    idx[wid] = {
        "path": str(dest),
        "url": wp.get("url", ""),
        "resolution": wp.get("resolution", ""),
    }
    idx = prune_cache(idx, config)
    save_index(idx)
    print(f"Saved: {dest.name}")
    set_wallpaper(dest, config)
    notify("Wallhaven", f"Set: {dest.name}", "low")


def cmd_clear():
    idx = load_index()
    if not idx:
        print("Cache index is already empty.")
        return

    print(f"Found {len(idx)} wallpapers in cache. Purging files...")
    deleted_count = 0
    for wid, info in idx.items():
        path_str = info.get("path")
        if path_str:
            p = Path(path_str)
            if p.exists():
                p.unlink(missing_ok=True)
                print(f"Deleted: {p.name}")
                deleted_count += 1

    save_index({})
    print(f"Successfully removed {deleted_count} files and cleared index.")
    notify("Wallhaven", f"Cleared {deleted_count} wallpapers from disk.", "normal")


LOCK = Path("/tmp/wallhaven-daemon.lock")


def cmd_daemon(config, run_loop=True):
    if not config.get("daemon_enabled", False):
        notify("Wallhaven", "Daemon disabled (set daemon_enabled: true in config)")
        return

    interval = config.get("interval_minutes", 5)
    if interval <= 0:
        notify("Wallhaven", "Daemon off (set interval_minutes > 0 in config)")
        return

    # Check lock
    try:
        pid = int(LOCK.read_text().strip())
        os.kill(pid, 0)
        notify("Wallhaven", "Daemon already running")
        return
    except (FileNotFoundError, ValueError, ProcessLookupError):
        pass

    # If the user requested the daemon to run in loop/background mode
    if run_loop:
        LOCK.write_text(str(os.getpid()))

        def unlock(*_):
            LOCK.unlink(missing_ok=True)
            notify("Wallhaven", "Daemon stopped")
            sys.exit(0)

        signal.signal(signal.SIGTERM, unlock)
        signal.signal(signal.SIGINT, unlock)

        notify("Wallhaven", f"Daemon started (every {interval} min)", "low")

        while True:
            try:
                cmd_random(config)
            except SystemExit:
                pass
            except Exception as e:
                notify("Wallhaven", f"Daemon error: {e}", "critical")
            time.sleep(interval * 60)
    else:
        LOCK.write_text(str(os.getpid()))
        try:
            cmd_random(config)
        except SystemExit:
            pass
        except Exception as e:
            notify("Wallhaven", f"Daemon error: {e}", "critical")
        finally:
            LOCK.unlink(missing_ok=True)


def cmd_version():
    print(f"wallhaven-fetch version {CURRENT_VERSION}")


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print("Usage:")
        print("  wallhaven-fetch random              Random from saved filters")
        print("  wallhaven-fetch daemon              Daemon mode (auto-rotate)")
        print("  wallhaven-fetch update              Update")
        print("  wallhaven-fetch version             Show script version")
        print("  wallhaven-fetch search <query>      search wallhaven")
        print("  wallhaven-fetch download <id>       Download by ID")
        print(
            "  wallhaven-fetch clear               Wipe downloaded wallpapers & cache"
        )
        print("  wallhaven-fetch config              Open config file")
        print(
            "  wallhaven-fetch external-daemon     Daemon mode (auto-rotate) (external mode)"
        )
        sys.exit(0)

    cmd = sys.argv[1]

    if cmd not in ("preview"):
        check_for_updates()

    if cmd in ("version", "-v", "--version"):
        cmd_version()
        sys.exit(0)

    try:
        config = load_config()
    except Exception as e:
        notify("Wallhaven", f"Config error: {e}", "critical")
        sys.exit(1)

    try:
        if cmd == "random":
            cmd_random(config)
        elif cmd == "check":
            check_for_updates()
        elif cmd == "update":
            cmd_update()
        elif cmd == "daemon":
            cmd_daemon(config)
        elif cmd == "external-daemon":
            cmd_daemon(config, run_loop=False)
        elif cmd == "clear":
            cmd_clear()
        elif cmd == "search" and len(sys.argv) > 2:
            args = sys.argv[2:]
            page_togo = 1

            if "--page" in args:
                try:
                    page_idx = args.index("--page")
                    page_togo = int(args[page_idx + 1])
                    args = args[:page_idx] + args[page_idx + 2 :]
                except (ValueError, IndexError):
                    print("Error: Invalid page number provided.", file=sys.stderr)
                    sys.exit(1)

            query = " ".join(args)
            cmd_search(config, query, page_togo)
        elif cmd == "preview" and len(sys.argv) > 2:
            cmd_preview(sys.argv[2])
        elif cmd == "download" and len(sys.argv) > 2:
            cmd_download(config, sys.argv[2])
        elif cmd == "config":
            subprocess.run([os.environ.get("EDITOR", "nano"), str(CONFIG_FILE)])
        else:
            print(f"Unknown command: {cmd}", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"Script Error: {e}")
        notify("Wallhaven", f"Error: {e}", "critical")


